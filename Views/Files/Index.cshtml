@using System.Security.Claims
@model IEnumerable<StoredFile>
@{
    ViewData["Title"] = "Archivos";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:F1} MB" :
        bytes >= 1024 ? $"{bytes / 1024.0:F1} KB" : $"{bytes} B";
}

@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Subir archivo (máx. 50 MB)</h5>
        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="d-flex gap-2">
            <input type="file" name="file" class="form-control" required />
            <button class="btn btn-primary">Subir</button>
        </form>
    </div>
</div>

<h4>Archivos compartidos</h4>
<table class="table table-striped align-middle">
    <thead>
        <tr><th>Nombre</th><th>Tamaño</th><th>Subido por</th><th>Fecha (UTC)</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var f in Model)
    {
        <tr>
            <td>@f.OriginalName</td>
            <td>@FormatSize(f.SizeBytes)</td>
            <td>@f.UploadedByEmail</td>
            <td>@f.UploadedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Download" asp-route-id="@f.Id">Descargar</a>
                @if (f.UploadedByUserId == currentUserId)
                {
                    <form asp-action="Delete" asp-route-id="@f.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar este archivo?');">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                }
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="5" class="text-center text-muted">Todavía no hay archivos.</td></tr>
    }
    </tbody>
</table>