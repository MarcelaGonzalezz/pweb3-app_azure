@using System.Security.Claims
@model IEnumerable<StoredFile>
@{
    ViewData["Title"] = "Explorar archivos";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:F1} MB" :
        bytes >= 1024 ? $"{bytes / 1024.0:F1} KB" : $"{bytes} B";
}

@if (TempData["Success"] is string ok) {
    <div class="alert alert-success"><i class="bi bi-check-circle"></i> @ok</div>
}
@if (TempData["Error"] is string err) {
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> @err</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title"><i class="bi bi-cloud-arrow-up"></i> Subir archivo (máx. 50 MB)</h5>
        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="d-flex gap-2">
            <input type="file" name="file" class="form-control" required />
            <button class="btn btn-primary">Subir</button>
        </form>
    </div>
</div>

<h4 class="mb-3"><i class="bi bi-globe2"></i> Archivos compartidos</h4>

@if (!Model.Any()) {
    <p class="text-muted">Todavía no hay archivos.</p>
} else {
    <table id="tablaArchivos" class="table table-striped align-middle">
        <thead>
            <tr><th>Nombre</th><th>Tamaño</th><th>Subido por</th><th>Fecha (UTC)</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var f in Model) {
                <tr>
                    <td><i class="bi bi-file-earmark-text"></i> @f.OriginalName</td>
                    <td data-order="@f.SizeBytes">@FormatSize(f.SizeBytes)</td>
                    <td>
                        <i class="bi bi-person-circle"></i> @f.UploadedByEmail
                        @if (f.UploadedByUserId == currentUserId) {
                            <span class="badge bg-primary">Tuyo</span>
                        }
                    </td>
                    <td>@f.UploadedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Download" asp-route-id="@f.Id"><i class="bi bi-download"></i> Descargar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        $(function () {
            $('#tablaArchivos').DataTable({
                language: { url: 'https://cdn.datatables.net/plug-ins/2.1.8/i18n/es-ES.json' },
                order: [[3, 'desc']],
                columnDefs: [{ orderable: false, targets: 4 }]
            });
        });
    </script>
}