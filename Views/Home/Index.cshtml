@{
    ViewData["Title"] = "Inicio";
}

<div class="p-5 mb-4 bg-light rounded-3 text-center">
    <h1 class="display-5 fw-bold"><i class="bi bi-cloud-arrow-up text-primary"></i> FileShare</h1>
    <p class="lead col-lg-8 mx-auto">
        Gestor de archivos en la nube desarrollado con ASP.NET Core MVC para Programación Web 3.
        Subí tus archivos, descargalos desde cualquier lugar y explorá lo que comparten otros usuarios.
    </p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Files" asp-action="MyFiles" class="btn btn-primary btn-lg me-2"><i class="bi bi-folder2-open"></i> Mis documentos</a>
        <a asp-controller="Files" asp-action="Explorar" class="btn btn-outline-primary btn-lg"><i class="bi bi-globe2"></i> Explorar</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg me-2"><i class="bi bi-box-arrow-in-right"></i> Ingresar</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg"><i class="bi bi-person-plus"></i> Registrarse</a>
    }
</div>

<h2 class="h4 text-center mb-3">Servicios de Azure que utiliza</h2>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <i class="bi bi-hdd-network fs-1 text-primary"></i>
                <h3 class="h5 mt-2">Blob Storage</h3>
                <p class="text-muted mb-0">Guarda los archivos subidos por los usuarios.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <i class="bi bi-database fs-1 text-primary"></i>
                <h3 class="h5 mt-2">Azure SQL Database</h3>
                <p class="text-muted mb-0">Guarda los usuarios y los datos de cada archivo.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <i class="bi bi-globe fs-1 text-primary"></i>
                <h3 class="h5 mt-2">App Service</h3>
                <p class="text-muted mb-0">Aloja la aplicación web en la nube.</p>
            </div>
        </div>
    </div>
</div>

<p class="text-center text-muted">
    Seguridad sin contraseñas: la app accede a Azure con <strong>Managed Identity</strong>.
</p>